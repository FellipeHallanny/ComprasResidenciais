# Variáveis de Ambiente para o Backend de Compras Residenciais

# Configurações do Servidor HTTP
PORT=8080

# Conexão PostgreSQL (com suporte a pgvector)
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/compras_residenciais?sslmode=disable

# Google Gemini API (para extração multimodal de fotos/PDFs e embeddings semânticos text-embedding-004)
GEMINI_API_KEY=

# SEFAZ (Webservice NfeConsultaProtocolo 4.00 com mTLS) - Opcional até inclusão do Certificado A1
SEFAZ_CERT_PATH=
SEFAZ_CERT_PASSWORD=
